{
	"name": "wikipedia-blame",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"format": "prettier --write",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@streamparser/json-whatwg": "^0.0",
		"@tanstack/react-pacer": "^0.19",
		"@tanstack/react-query": "^5.90",
		"@tanstack/react-query-devtools": "^5.91",
		"react": "^19.2",
		"react-dom": "^19.2",
		"react-error-boundary": "^6.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0",
		"@testing-library/jest-dom": "^6.9",
		"@testing-library/react": "^16.3",
		"@testing-library/user-event": "^14.6",
		"@types/react": "^19.2",
		"@types/react-dom": "^19.2",
		"@vitejs/plugin-react": "^5.1",
		"babel-plugin-react-compiler": "^1.0",
		"eslint": "^10.0",
		"eslint-plugin-react-hooks": "^7.0",
		"eslint-plugin-react-refresh": "^0.5",
		"globals": "^17.3",
		"happy-dom": "^20.6",
		"prettier": "^3.8",
		"typescript": "~5.9",
		"typescript-eslint": "^8.56",
		"vite": "^7.3",
		"vitest": "^4.0"
	},
	"overrides": {
		"eslint-plugin-react-hooks": {
			"eslint": "$eslint"
		}
	}
